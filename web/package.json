{
  "name": "charturbo",
  "version": "0.1.0",
  "description": "GPU-accelerated charting for the web: Rust + WebGPU (WebAssembly, WebGL2 fallback) line, area, bar, scatter, candlestick, heatmap, box/violin, pie, combo, radar, gauge, funnel, waterfall, treemap, sunburst, sankey and sparkline charts with 1M+ points at 60 FPS, real-time streaming, accessibility, SVG/PNG/PDF export and React / Vue components",
  "type": "module",
  "license": "MIT",
  "author": "TODO <author name and email>",
  "homepage": "https://github.com/jparkk0517/Charturbo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jparkk0517/Charturbo.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/jparkk0517/Charturbo/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "sideEffects": [
    "./dist-lib/inline.js",
    "./dist-lib/charturbo.umd.cjs"
  ],
  "main": "./dist-lib/charturbo.umd.cjs",
  "module": "./dist-lib/charturbo.js",
  "types": "./dist-lib/index.d.ts",
  "unpkg": "./dist-lib/charturbo.umd.cjs",
  "jsdelivr": "./dist-lib/charturbo.umd.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-lib/index.d.ts",
        "default": "./dist-lib/charturbo.js"
      },
      "require": {
        "types": "./dist-lib/index.d.cts",
        "default": "./dist-lib/charturbo.umd.cjs"
      },
      "default": {
        "types": "./dist-lib/index.d.ts",
        "default": "./dist-lib/charturbo.js"
      }
    },
    "./inline": {
      "import": {
        "types": "./dist-lib/inline.d.ts",
        "default": "./dist-lib/inline.js"
      },
      "require": {
        "types": "./dist-lib/inline.d.cts",
        "default": "./dist-lib/charturbo.umd.cjs"
      },
      "default": {
        "types": "./dist-lib/inline.d.ts",
        "default": "./dist-lib/inline.js"
      }
    },
    "./react": {
      "types": "./dist-lib/react/index.d.ts",
      "import": "./dist-lib/react.js",
      "default": "./dist-lib/react.js"
    },
    "./vue": {
      "types": "./dist-lib/vue/index.d.ts",
      "import": "./dist-lib/vue.js",
      "default": "./dist-lib/vue.js"
    },
    "./umd": "./dist-lib/charturbo.umd.cjs",
    "./charturbo_core_bg.wasm": "./dist-lib/charturbo_core_bg.wasm",
    "./webgpu": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/charturbo-webgpu.js",
      "default": "./dist-lib/charturbo-webgpu.js"
    },
    "./inline-webgpu": {
      "types": "./dist-lib/inline.d.ts",
      "import": "./dist-lib/inline-webgpu.js",
      "default": "./dist-lib/inline-webgpu.js"
    },
    "./webgpu-umd": "./dist-lib/charturbo-webgpu.umd.cjs",
    "./charturbo_core_bg-webgpu.wasm": "./dist-lib/charturbo_core_bg-webgpu.wasm",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "inline": [
        "./dist-lib/inline.d.ts"
      ],
      "react": [
        "./dist-lib/react/index.d.ts"
      ],
      "vue": [
        "./dist-lib/vue/index.d.ts"
      ]
    }
  },
  "files": [
    "dist-lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "chart",
    "charts",
    "charting",
    "data-visualization",
    "webgpu",
    "wasm",
    "rust",
    "high-performance",
    "large-dataset",
    "million-points",
    "real-time",
    "streaming",
    "line-chart",
    "area-chart",
    "bar-chart",
    "scatter-plot",
    "candlestick",
    "histogram",
    "heatmap",
    "boxplot",
    "pie-chart",
    "sparkline",
    "webgl",
    "typescript",
    "dashboard",
    "combo-chart",
    "radar-chart",
    "gauge",
    "funnel",
    "waterfall",
    "treemap",
    "sunburst",
    "sankey",
    "violin-plot",
    "accessibility",
    "react",
    "vue",
    "graph-visualization",
    "3d"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode umd && tsc -p tsconfig.lib.json && node scripts/finalize-dts.mjs",
    "build:lib:webgpu": "vite build --config vite.lib.config.ts --mode webgpu && vite build --config vite.lib.config.ts --mode webgpu-umd",
    "wasm:build": "wasm-pack build ../crates/charturbo-core --target web --out-dir ../../web/src/wasm-pkg --release",
    "wasm:webgpu": "wasm-pack build ../crates/charturbo-core --target web --out-dir ../../web/src/wasm-pkg-webgpu --release --no-default-features",
    "test": "vitest run",
    "test:visual": "node e2e/run-visual.mjs",
    "docs": "typedoc",
    "examples:dev": "vite --config examples/vite.config.ts",
    "examples:build": "tsc -p examples/tsconfig.json && vite build --config examples/vite.config.ts",
    "examples:preview": "vite preview --config examples/vite.config.ts",
    "examples:shots": "npm run examples:build && node examples/scripts/capture-screens.mjs",
    "prepack": "npm run build:lib && npm run build:lib:webgpu",
    "prepublishOnly": "node scripts/check-release-metadata.mjs",
    "bench": "node bench/run-bench.mjs",
    "bench:charts": "node bench/readme-charts.mjs",
    "bench:report:check": "node bench/check-report.mjs",
    "bench:physics:check": "node bench/check-gpu-physics.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cosmos.gl/graph": "^3.5.1",
    "@deck.gl/core": "~9.3.11",
    "@deck.gl/layers": "~9.3.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "3d-force-graph": "^1.80.1",
    "chart.js": "^4.6.1",
    "chartgpu": "^0.4.0",
    "echarts": "^6.1.0",
    "highcharts": "^13.1.1",
    "jsdom": "^30.1.3",
    "plotly.js-gl2d-dist-min": "^4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scichart": "^6.0.14",
    "three": "^0.186.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.3",
    "uplot": "^1.6.32",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
